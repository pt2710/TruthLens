# TruthLens environment example
# Copy values into a local .env for development only.
# Do not commit real credentials.

# Public client configuration
VITE_TRUTHLENS_API_BASE=http://127.0.0.1:8000

# Server runtime configuration
TRUTHLENS_ENV=local
TRUTHLENS_API_HOST=127.0.0.1
TRUTHLENS_API_PORT=8000
TRUTHLENS_PUBLIC_API_BASE=http://127.0.0.1:8000
TRUTHLENS_STORAGE_ROOT=
TRUTHLENS_DATABASE_URL=postgresql+psycopg://truthlens:truthlens@localhost:5432/truthlens
TRUTHLENS_RUNTIME_EVENT_STORE=local
TRUTHLENS_LOCAL_EVENT_FALLBACK_ENABLED=true
TRUTHLENS_REQUIRE_API_KEY=false
TRUTHLENS_RATE_LIMIT_PER_MINUTE=240
TRUTHLENS_OPERATOR_MODE=end-user
TRUTHLENS_OPERATOR_ID=

# Server-only optional AI/report configuration
TRUTHLENS_GEMINI_API_KEY=
TRUTHLENS_GEMINI_MODEL=gemini-2.5-flash
TRUTHLENS_GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Server-only optional YouTube OAuth configuration
TRUTHLENS_YOUTUBE_DIRECT_REPORTING_ENABLED=true
TRUTHLENS_YOUTUBE_CLIENT_ID=
TRUTHLENS_YOUTUBE_CLIENT_SECRET=
TRUTHLENS_YOUTUBE_REDIRECT_URI=
TRUTHLENS_YOUTUBE_AUTH_SCOPE=https://www.googleapis.com/auth/youtube.force-ssl
TRUTHLENS_YOUTUBE_LANGUAGE=en-US

# Optional access control for hosted beta
TRUTHLENS_API_KEY=
