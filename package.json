{
  "name": "truthlens",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "lint": "pnpm exec eslint apps/extension/src libs/shared-schemas/src --ext .ts,.tsx",
    "typecheck": "pnpm --filter @truthlens/shared-schemas typecheck && pnpm --filter @truthlens/extension typecheck",
    "test": "pnpm --filter @truthlens/shared-schemas test && pnpm --filter @truthlens/extension test",
    "build": "pnpm --filter @truthlens/shared-schemas build && pnpm --filter @truthlens/extension build",
    "format": "pnpm exec prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.26.1"
  }
}
