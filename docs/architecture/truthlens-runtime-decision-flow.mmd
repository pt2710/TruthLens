flowchart LR

classDef implemented fill:#f8fbff,stroke:#1d4ed8,stroke-width:1.8px,color:#0f172a;
classDef contract fill:#ecfeff,stroke:#0f766e,stroke-width:1.8px,color:#0f172a;
classDef policy fill:#fff7ed,stroke:#c2410c,stroke-width:1.8px,color:#0f172a;
classDef offline fill:#f8fafc,stroke:#475569,stroke-width:1.5px,color:#0f172a;

discover["Feed/watch discovery<br/>YouTube DOM cards and metadata"]:::implemented
eligibility{"Scoreable YouTube video item?"}:::contract
excluded["No-op for ads / external cards<br/>no badge, no rerank, no event, no context-menu target"]:::implemented
request["Score request<br/>title, channel, thumbnail ref, description/context when available"]:::implemented
hosted["Hosted FastAPI scoring endpoint<br/>Render beta API"]:::implemented
router["Adaptive Semantic Evidence Router<br/>content_class | runtime_route | guard | capture plan"]:::contract
minimal["minimal_creative + clean<br/>reduced mismatch pressure<br/>skip unnecessary remote thumbnail bytes"]:::contract
strict["informational / high-risk / ambiguous routes<br/>normal or elevated consistency pressure"]:::contract
perception["Perception + calibration<br/>risk, confidence, uncertainty, contributors"]:::implemented
selective["Selective verification<br/>triggered only by risk, uncertainty, mismatch, or explicit review"]:::contract
bseo["BSEO policy interpretation<br/>downstream pressure and guardrails"]:::policy
score["Score contract<br/>10.0 best | 0.0 worst<br/>recommended_action and reasons"]:::contract
render["Extension presentation<br/>numeric score + action badge + local rerank"]:::implemented
manual["Explicit verify/report open<br/>human review, optional Gemini wording, final user action"]:::implemented
capture["Learning capture context<br/>route, score, feedback, observation, outcome<br/>not direct benchmark ingestion"]:::offline

discover --> eligibility
eligibility -- no --> excluded
eligibility -- yes --> request --> hosted --> router
router --> minimal --> perception
router --> strict --> perception
perception --> selective --> bseo --> score --> render
render --> manual
score --> capture
manual --> capture
